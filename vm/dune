(rule
 (target vm)
 (mode
  (promote (until-clean)))
 (deps Makefile vm.c bytecode.c bytecode.h state.h callstack.h csval.h error.h ../runtime/runtime.a)
 (action
  (run make)))

(rule
 (target vm-allsan)
 (mode
  (promote (until-clean)))
 (deps Makefile vm.c bytecode.c bytecode.h state.h callstack.h csval.h error.h ../runtime/runtime.a)
 (action
  (run make vm-allsan)))