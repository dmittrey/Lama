(rule
 (target bcfreq)
 (mode
  (promote (until-clean)))
 (deps Makefile main.cc bcfreq.hh bcfreq.cc ../byterun/bytefile.h ../byterun/bytefile.c ../byterun/disasm.h ../runtime/runtime.a)
 (action
  (run make)))

(rule
 (target bcfreq-allsan)
 (mode
  (promote (until-clean)))
 (deps Makefile main.cc bcfreq.hh bcfreq.cc ../byterun/bytefile.h ../byterun/bytefile.c ../byterun/disasm.h ../runtime/runtime.a)
 (action
  (run make debug)))

